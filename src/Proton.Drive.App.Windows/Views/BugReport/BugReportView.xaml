<UserControl
    x:Class="Proton.Drive.App.Windows.Views.BugReport.BugReportView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:Proton.Drive.App.Windows.Toolkit.Behaviors"
    xmlns:bugReport="clr-namespace:Proton.Drive.App.Windows.Views.BugReport"
    xmlns:controls="clr-namespace:Proton.Drive.App.Windows.Controls"
    xmlns:converters="clr-namespace:Proton.Drive.App.Windows.Toolkit.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Proton.Drive.App.Windows.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontSize="{StaticResource TextBlock.Default.FontSize}"
    TextBlock.LineHeight="14"
    Margin="20,10,20,20"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance bugReport:BugReportViewModel}">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text.DarkTheme.Brush}" />
        </Style>
    </UserControl.Resources>

    <b:Interaction.Behaviors>
        <behaviors:CloseDataContextOnUnloadBehavior />
    </b:Interaction.Behaviors>

    <StackPanel>
        <Border Style="{StaticResource RoundedSection.DarkTheme}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Resource BugReport_NeedHelp_Title}"
                    FontSize="{StaticResource TextBlock.Caption.FontSize}" />

                <TextBlock
                    Text="{loc:Resource BugReport_NeedHelp_Description}"
                    Foreground="{StaticResource GrayBrush}"
                    Margin="0,7,0,0" />

                <Button
                    Content="{loc:Resource BugReport_NeedHelp_Link_HowProtonDriveWorks}"
                    Command="{Binding OpenHowProtoDriveWorksLink}"
                    Style="{StaticResource HyperlinkButtonStyle}"
                    Margin="0,7,0,0" />

                <Button
                    Content="{loc:Resource BugReport_NeedHelp_Link_UseOnDemandSync}"
                    Command="{Binding OpenUseOnDemandSyncLink}"
                    Style="{StaticResource HyperlinkButtonStyle}" />

                <Button
                    Content="{loc:Resource BugReport_NeedHelp_Link_SyncFolders}"
                    Command="{Binding OpenSyncFoldersToProtonDriveLink}"
                    Style="{StaticResource HyperlinkButtonStyle}" />

                <Button
                    Content="{loc:Resource BugReport_NeedHelp_Link_HowSharedFilesWork}"
                    Command="{Binding OpenHowSharedFilesWorkLink}"
                    Style="{StaticResource HyperlinkButtonStyle}" />

                <Button
                    Content="{loc:Resource BugReport_NeedHelp_Link_FAQ}"
                    Command="{Binding OpenFaqLink}"
                    Style="{StaticResource HyperlinkButtonStyle}" />
            </StackPanel>
        </Border>

        <Grid
            Width="500"
            Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Target="{Binding ElementName=EmailTextBox}">
                <TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <AccessText Text="{loc:Resource BugReport_Text_Email_Label}" />
                        <TextBlock
                            Text="*"
                            Margin="5,0,0,0" />
                    </StackPanel>
                </TextBlock>
            </Label>

            <TextBox
                Name="EmailTextBox"
                AutomationProperties.HelpText="{loc:Resource BugReport_Text_Email_HelpText}"
                Grid.Row="1"
                Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding ReportSuccessfullySent, Converter={x:Static converters:BooleanToOppositeBooleanConverter.Instance}}"
                Margin="0,10,0,0" />

            <Label
                Grid.Row="2"
                Target="{Binding ElementName=TitleTextBox}"
                Margin="0,10,0,0">
                <TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <AccessText Text="{loc:Resource BugReport_Text_IssueTitle_Label}" />
                        <TextBlock
                            Text="*"
                            Margin="5,0,0,0" />
                    </StackPanel>
                </TextBlock>
            </Label>

            <TextBox
                Name="TitleTextBox"
                AutomationProperties.HelpText="{loc:Resource BugReport_Text_IssueTitle_HelpText}"
                Grid.Row="3"
                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                IsEnabled="{Binding ReportSuccessfullySent, Converter={x:Static converters:BooleanToOppositeBooleanConverter.Instance}}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Visible"
                Height="50"
                VerticalAlignment="Top"
                VerticalContentAlignment="Top"
                Margin="0,10,0,0" />

            <TextBlock
                Grid.Row="3"
                Text="{loc:Resource BugReport_Text_IssueTitle_Watermark}"
                Style="{StaticResource WatermarkStyle}"
                Visibility="{Binding Text, ElementName=TitleTextBox, Converter={x:Static converters:ObjectEqualityToVisibilityConverter.NotEqualIsCollapsed}, ConverterParameter=''}"
                VerticalAlignment="Top"
                Margin="8,15,0,0" />

            <WrapPanel
                Grid.Row="4"
                Margin="0,10,0,0">
                <Label
                    Name="DescriptionLabel"
                    Target="{x:Reference DescriptionTextBox}">
                    <StackPanel Orientation="Horizontal">
                        <AccessText Text="{loc:Resource BugReport_Text_Description_Label}" />
                        <TextBlock
                            Foreground="{StaticResource GrayBrush}"
                            Margin="5,0,0,0">
                            <Run Text="{loc:Resource BugReport_Text_Description_Label_Requirement}" />
                            <Run Text="*" />
                        </TextBlock>
                    </StackPanel>
                </Label>
            </WrapPanel>

            <TextBox
                Name="DescriptionTextBox"
                AutomationProperties.HelpText="{loc:Resource BugReport_Text_Description_HelpText}"
                AutomationProperties.LabeledBy="{x:Reference DescriptionLabel}"
                Grid.Row="5"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                IsEnabled="{Binding ReportSuccessfullySent, Converter={x:Static converters:BooleanToOppositeBooleanConverter.Instance}}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Visible"
                Height="120"
                VerticalAlignment="Top"
                VerticalContentAlignment="Top"
                Margin="0,10,0,0" />

            <TextBlock
                Grid.Row="5"
                Style="{StaticResource WatermarkStyle}"
                Visibility="{Binding Text, ElementName=DescriptionTextBox, Converter={x:Static converters:ObjectEqualityToVisibilityConverter.NotEqualIsCollapsed}, ConverterParameter=''}"
                VerticalAlignment="Top"
                Margin="8,15,0,0">
                <Run Text="{loc:Resource BugReport_Text_Description_Watermark_ExactSteps}" />
                <LineBreak />
                <Run Text="{loc:Resource BugReport_Text_Description_Watermark_WhatWentWrong}" />
            </TextBlock>

            <Grid
                Grid.Row="6"
                Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    Content="{loc:Resource BugReport_CheckBox_IncludeLogs}"
                    Foreground="White"
                    IsChecked="{Binding IncludeLogs}"
                    IsEnabled="{Binding ReportSuccessfullySent, Converter={x:Static converters:BooleanToOppositeBooleanConverter.Instance}}" />

                <Image
                    Grid.Column="1"
                    Source="{StaticResource Icon.InfoCircle}"
                    ToolTip="{loc:Resource BugReport_CheckBox_IncludeLogs_Tooltip}"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Margin="7,2,0,0" />

                <Button
                    Grid.Column="2"
                    Content="{loc:Resource BugReport_Button_ShowLogs}"
                    Command="{Binding OpenLogsFolderCommand}"
                    FontSize="{StaticResource TextBlock.Small.FontSize}"
                    Style="{StaticResource HyperlinkButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                Grid.Row="7"
                Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding ErrorMessage}"
                    Foreground="{StaticResource NegativeBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{Binding ErrorMessage, Converter={x:Static converters:ObjectEqualityToVisibilityConverter.EqualIsCollapsed}, ConverterParameter={x:Null}}"
                    MaxHeight="60"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />

                <controls:ProgressRing
                    Grid.Column="0"
                    Visibility="{Binding IsBusy, Converter={x:Static converters:BooleanToVisibilityConverter.FalseIsCollapsed}}"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0" />

                <TextBlock
                    Grid.Column="0"
                    Text="{loc:Resource BugReport_Text_ReportSuccessfullySent}"
                    Foreground="{StaticResource PositiveBrush}"
                    Visibility="{Binding ReportSuccessfullySent, Converter={x:Static converters:BooleanToVisibilityConverter.FalseIsCollapsed}}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    AutomationProperties.HelpText="{loc:Resource BugReport_helpText_Button_Report}"
                    Grid.Column="1"
                    Content="{loc:Resource BugReport_Button_Report}"
                    Command="{Binding ReportBugCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center" />

                <Button
                    AutomationProperties.HelpText="{loc:Resource BugReport_Button_Cancel_HelpText}"
                    Grid.Column="2"
                    Content="{loc:Resource BugReport_Button_Cancel}"
                    Command="SystemCommands.CloseWindowCommand"
                    IsCancel="True"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
