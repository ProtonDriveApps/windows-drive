<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)-windows10.0.17763.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.17763.56</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtonDrive.Shared\ProtonDrive.Shared.csproj" />
    <ProjectReference Include="..\ProtonDrive.Sync.Shared\ProtonDrive.Sync.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="System.Linq.Async" />
    <PackageReference Include="Vanara.PInvoke.CldApi" />
    <PackageReference Include="Vanara.PInvoke.Shell32" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtonDrive.Sync.Adapter.Tests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Add a custom global namespaces for the entire project -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
