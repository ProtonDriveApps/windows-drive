    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="Vanara.PInvoke.CldApi" Version="5.0.8" />
    <PackageVersion Include="Vanara.PInvoke.Shell32" Version="5.0.8" />
